{% extends 'base.html.twig' %}

{% block title %}Modifier le Livre{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Modifier le livre: {{ book.title }}</h1>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_row(form.title) }}
                </div>
                <div class="mb-3">
                    {{ form_row(form.publicationDate) }}
                </div>
                <div class="mb-3 form-check">
                    {{ form_row(form.published) }}
                </div>
                <div class="mb-3">
                    {{ form_row(form.author) }}
                </div>
                <div class="mb-3">
                    {{ form_row(form.readers) }}
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Enregistrer
                    </button>
                    <a href="{{ path('app_book_index') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Retour à la liste
                    </a>
                    <a href="{{ path('app_book_show', {'id': book.id}) }}" class="btn btn-info">
                        <i class="bi bi-eye"></i> Voir
                    </a>
                </div>
            {{ form_end(form) }}

            <hr class="my-4">

            <form method="post" action="{{ path('app_book_delete', {'id': book.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce livre ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ book.id) }}">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Supprimer ce livre
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
